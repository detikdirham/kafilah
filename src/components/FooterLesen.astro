---
import data from '../data/penulis.json';
const p = data.asri;
const s = data.syarikat;
const tahun = new Date().getFullYear();
---
<footer class="kaki">
  <div class="tapak">
    <p class="kaki-utama">
      Kafilah ditulis oleh <strong>{p.namaPena}</strong>, ejen berdaftar <strong>{s.nama}</strong>. <a href={p.urlSemakan} rel="nofollow noopener" target="_blank">Semak status ejen</a>
    </p>
    <p>
      Kandungan di laman ini adalah panduan am, bukan tawaran pakej.
      Semua bayaran berkaitan pakej perlu dibuat ke akaun syarikat
      Andalusia sahaja.
    </p>
    <p class="nota">&copy; {tahun} Kafilah</p>
  </div>
</footer>
