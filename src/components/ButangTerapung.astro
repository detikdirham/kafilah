---
import data from '../data/penulis.json';
import { mesejWa, type Bahagian } from '../data/mesejWa';

interface Props { bahagian?: Bahagian }
const { bahagian } = Astro.props;
const p = data.asri;
const pautan = `https://wa.me/${p.telefonAntarabangsa}?text=${encodeURIComponent(mesejWa(bahagian))}`;
---
<a
  class="terapung"
  href={pautan}
  rel="nofollow noopener"
  target="_blank"
  aria-label="Tanya melalui WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.58-.35Z"></path>
    <path d="M12.04 2h-.01C6.5 2 2 6.5 2 12.04c0 1.77.46 3.5 1.34 5.02L2 22l5.06-1.32a10 10 0 0 0 4.98 1.3h.01c5.53 0 10.03-4.5 10.03-10.04C22.08 6.5 17.58 2 12.04 2Zm5.85 15.89c-.25.7-1.45 1.33-2 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.99-.32-1.7-.63-2.98-1.29-4.93-4.29-5.08-4.49-.15-.2-1.22-1.62-1.22-3.08S7 8.73 7.27 8.42c.28-.3.6-.38.8-.38h.57c.18 0 .43-.07.67.51.25.59.84 2.05.92 2.2.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.39-.45.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.66 2.06 1.14 1.02 2.1 1.33 2.4 1.48.3.15.48.13.65-.07.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.13.5.2.58.35.07.13.07.72-.18 1.42Z"></path>
  </svg>
  <span>Tanya</span>
</a>

<script>
  // Butang hanya muncul selepas pembaca benar-benar membaca, dan
  // bersembunyi apabila ajakan WhatsApp sebenar sudah kelihatan.
  // Tujuannya menolong, bukan mengganggu bacaan.
  const butang = document.querySelector<HTMLElement>('.terapung');

  if (butang) {
    let lepasSkrol = false;
    let adaYangLain = 0;

    const kemasKini = () => {
      butang.classList.toggle('nampak', lepasSkrol && adaYangLain === 0);
    };

    const semakSkrol = () => {
      const baru = window.scrollY > 600;
      if (baru !== lepasSkrol) { lepasSkrol = baru; kemasKini(); }
    };

    window.addEventListener('scroll', semakSkrol, { passive: true });
    semakSkrol();

    // Jangan bertindih dengan blok CTA atau footer.
    const sasaran = document.querySelectorAll('.cta, .kaki');
    if (sasaran.length && 'IntersectionObserver' in window) {
      const pemerhati = new IntersectionObserver((entri) => {
        for (const e of entri) {
          adaYangLain += e.isIntersecting ? 1 : -1;
        }
        if (adaYangLain < 0) adaYangLain = 0;
        kemasKini();
      });
      sasaran.forEach((s) => pemerhati.observe(s));
    }
  }
</script>
