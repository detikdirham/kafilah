---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaWhatsapp from '../../components/CtaWhatsapp.astro';

const entri = (await getCollection('haji', ({ data }) => !data.draf))
  .sort((a, b) => a.data.tajuk.localeCompare(b.data.tajuk, 'ms'));
const hab = [...new Set(entri.map((e) => e.data.hab))].sort();
---
<Base
  penuh
  bahagian="haji"
  tajuk="Panduan Haji Malaysia: Giliran, Rayuan, PJH dan Kos Sebenar"
  penerangan="Bagaimana rakyat Malaysia pergi haji apabila giliran mencecah lebih seratus tahun. Rayuan, PJH, kos sebenar dan persediaan untuk jemaah berumur."
>
  <section class="hero hero-jenama">
    <div class="tapak">
      <Breadcrumb jejak={[{ nama: 'Laman utama', url: '/' }, { nama: 'Haji', url: '/haji/' }]} />
      <h1>Panduan Haji Malaysia</h1>
      <p class="hero-sub">
        Daftar hari ini, tahun peruntukan anda jatuh sekitar 2168. Bagi orang
        berumur 60 tahun, itu bermakna giliran biasa bukan rancangan.
      </p>
      <p class="hero-nota">
        Halaman di bawah menerangkan pilihan yang tinggal, dan berapa kosnya,
        tanpa menjual apa-apa kepada anda.
      </p>
    </div>
  </section>

  {hab.map((h, i) => (
    <section class={i % 2 === 0 ? 'jalur jalur-dalam' : 'jalur'}>
      <div class="tapak">
        <div class="seksyen-tajuk"><h2>{h}</h2></div>
        <ul class="kad-grid">
          {entri.filter((e) => e.data.hab === h).map((e) => (
            <li>
              <a class="kad" href={`/haji/${e.id}/`}>
                <span class="kad-tajuk">{e.data.tajuk}</span>
                <span class="kad-soalan">{e.data.soalanUtama}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="jalur">
    <div class="tapak">
      <CtaWhatsapp bahagian="haji" />
    </div>
  </section>
</Base>
