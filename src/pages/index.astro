---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';

const haji = (await getCollection('haji', ({ data }) => !data.draf))
  .map((e) => ({ ...e, bahagian: 'haji' }));
const umrah = (await getCollection('umrah', ({ data }) => !data.draf))
  .map((e) => ({ ...e, bahagian: 'umrah' }));
const panduan = [...haji, ...umrah]
  .sort((a, b) => a.data.tajuk.localeCompare(b.data.tajuk, 'ms'));
---
<Base
  penuh
  tajuk="Kafilah: Panduan Haji, Umrah dan Pelancongan Islamik"
  penerangan="Panduan jujur untuk bakal pesara, pesara, dan anak dewasa yang menaja ibu bapa ke Tanah Suci. Ditulis oleh ejen berdaftar, boleh disahkan."
>
  <section class="hero hero-jenama">
    <div class="tapak">
      <h1>Tiada siapa pergi seorang</h1>
      <p class="hero-sub">
        Panduan haji, umrah dan pelancongan Islamik untuk bakal pesara, pesara,
        dan anak dewasa yang menaja ibu bapa.
      </p>
      <p class="hero-nota">
        Saya tidak jual pakej di laman ini. Saya terangkan keputusan. Kalau selepas
        membaca anda rasa pakej kami bukan yang sesuai untuk keluarga anda, itu
        jawapan yang baik juga.
      </p>
      <div class="hero-cta">
        <a class="butang" href="/haji/">Mula dengan panduan haji</a>
        <a class="butang-kedua" href="/tentang/">Siapa yang tulis ini</a>
      </div>
      <ul class="amanah">
        <li>Ejen berdaftar, boleh disahkan</li>
        <li>Tiada borang, tiada bayaran</li>
        <li>Tiada follow up berulang</li>
      </ul>
    </div>
  </section>

  <section class="jalur jalur-dalam">
    <div class="tapak">
      <p class="angka-tajuk">Keadaan sebenar sistem haji Malaysia</p>
      <dl class="angka">
        <div><dt>2168</dt><dd>Tahun peruntukan bagi pendaftar baharu hari ini</dd></div>
        <div><dt>4 juta</dt><dd>Pendaftar sedang menunggu giliran</dd></div>
        <div><dt>31,600</dt><dd>Kuota haji Malaysia setahun</dd></div>
        <div><dt>RM15,000</dt><dd>Baki minimum sebelum tawaran haji</dd></div>
      </dl>
    </div>
  </section>

  <section class="jalur">
    <div class="tapak">
      <div class="seksyen-tajuk">
        <h2>Mula di sini</h2>
        <p>
          Pengeluaran Akaun Sejahtera KWSP dibuka pada umur 50, dan keputusannya
          bermula lebih awal daripada itu. Wang itu boleh jadi haji, boleh jadi
          umrah sekeluarga, boleh jadi bertahan sampai hujung. Selalunya bukan
          ketiga-tiganya sekali.
        </p>
      </div>
      <ul class="kad-grid">
        {panduan.map((e) => (
          <li>
            <a class="kad" href={`/${e.bahagian}/${e.id}/`}>
              <span class="kad-hab">{e.data.hab}</span>
              <span class="kad-tajuk">{e.data.tajuk}</span>
              <span class="kad-soalan">{e.data.soalanUtama}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="jalur jalur-dalam">
    <div class="tapak">
      <CtaWhatsapp />
    </div>
  </section>
</Base>
