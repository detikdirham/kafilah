---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import FooterLesen from '../components/FooterLesen.astro';
import ButangTerapung from '../components/ButangTerapung.astro';
import type { Bahagian } from '../data/mesejWa';

interface Props {
  tajuk: string;
  penerangan: string;
  jenis?: 'website' | 'article';
  dikemaskini?: Date;
  namaPenulis?: string;
  /** true untuk muka pemasaran yang uruskan jalur sendiri */
  penuh?: boolean;
  /** menentukan teks pembuka WhatsApp pada butang terapung */
  bahagian?: Bahagian;
}
const { penuh = false, bahagian, ...props } = Astro.props;
---
<!doctype html>
<html lang="ms">
  <head><SeoHead {...props} /></head>
  <body>
    <a class="langkau" href="#kandungan">Langkau ke kandungan</a>
    <header class="kepala">
      <div class="tapak">
        <a class="jenama" href="/">Kafilah<span>Tiada siapa pergi seorang</span></a>
        <nav class="nav-utama" aria-label="Utama">
          <a href="/haji/">Haji</a>
          <a href="/umrah/">Umrah</a>
          <a href="/tentang/">Tentang</a>
        </nav>
      </div>
    </header>
    <main id="kandungan" class={penuh ? '' : 'utama'}>
      {penuh ? <slot /> : <div class="tapak"><slot /></div>}
    </main>
    <FooterLesen />
    <ButangTerapung bahagian={bahagian} />
  </body>
</html>
