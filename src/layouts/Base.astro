---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import FooterLesen from '../components/FooterLesen.astro';

interface Props {
  tajuk: string;
  penerangan: string;
  jenis?: 'website' | 'article';
  dikemaskini?: Date;
  namaPenulis?: string;
}
const props = Astro.props;
---
<!doctype html>
<html lang="ms">
  <head><SeoHead {...props} /></head>
  <body>
    <a class="langkau" href="#kandungan">Langkau ke kandungan</a>
    <header class="kepala">
      <div class="tapak">
        <a class="jenama" href="/">Kafilah<span>Tiada siapa pergi seorang</span></a>
        <nav class="nav-utama" aria-label="Utama">
          <a href="/haji/">Haji</a>
          <a href="/tentang/">Tentang</a>
        </nav>
      </div>
    </header>
    <main class="utama" id="kandungan">
      <div class="tapak"><slot /></div>
    </main>
    <FooterLesen />
  </body>
</html>
