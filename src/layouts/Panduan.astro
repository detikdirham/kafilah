---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PautanBerkaitan from '../components/PautanBerkaitan.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import penulisData from '../data/penulis.json';

interface Props { entri: CollectionEntry<'haji'>; bahagian: 'haji' | 'umrah' | 'pelancongan' }
const { entri, bahagian } = Astro.props;
const d = entri.data;
const p = penulisData.asri;
const namaBahagian = { haji: 'Haji', umrah: 'Umrah', pelancongan: 'Pelancongan' }[bahagian];
const tarikh = d.dikemaskini.toLocaleDateString('ms-MY', { day: 'numeric', month: 'long', year: 'numeric' });

// Jejak roti mengikut sarang sebenar. Halaman seperti
// rayuan-haji/peluang-lulus perlu menunjukkan induknya.
const semua = await getCollection(bahagian);
const segmen = entri.id.split('/');
const jejak = [
  { nama: 'Laman utama', url: '/' },
  { nama: namaBahagian, url: `/${bahagian}/` },
];
for (let i = 0; i < segmen.length; i++) {
  const id = segmen.slice(0, i + 1).join('/');
  const induk = semua.find((e) => e.id === id);
  if (induk) jejak.push({ nama: induk.data.tajuk, url: `/${bahagian}/${id}/` });
}
---
<Base
  tajuk={d.tajuk}
  penerangan={d.penerangan}
  jenis="article"
  dikemaskini={d.dikemaskini}
  namaPenulis={p.nama}
  bahagian={bahagian}
>
  <Breadcrumb jejak={jejak} />
  <article>
    <h1>{d.tajuk}</h1>
    <p class="soalan">{d.soalanUtama}</p>
    <div class="prosa"><slot /></div>
    <p class="meta">
      Dikemas kini {tarikh} oleh <a href="/tentang/">{p.namaPena}</a>
      ({p.nama}), {p.peranan}. ID Ejen {p.idEjen}.
    </p>
  </article>
  <PautanBerkaitan slug={d.berkaitan} bahagian={bahagian} />
  <CtaWhatsapp bahagian={bahagian} />
</Base>
