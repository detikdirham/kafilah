{
  "name": "kafilah",
  "compatibility_date": "2026-09-20",
  // Satu tapak, satu alamat. Ditetapkan di sini dan bukan dalam dashboard,
  // kerana deploy Wrangler akan menghidupkan semula tetapan dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "observability": { "enabled": true }
}
